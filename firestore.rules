rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.role : null; }
    function staff() { return role() == 'staff' || role() == 'admin'; }
    function admin() { return role() == 'admin'; }

    // The web app reads/writes business data through Cloud Functions.
    // Direct client access stays narrow so a compromised browser cannot bypass workflow rules.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || staff());
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /stations/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /badges/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /registrations/{id} {
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || staff());
      allow write: if false;
    }

    match /punches/{id} {
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || staff());
      allow write: if false;
    }

    match /cardDraws/{id} {
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || staff());
      allow write: if false;
    }

    match /userBadges/{id} {
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || staff());
      allow write: if false;
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /auditLog/{id} {
      allow read: if staff();
      allow write: if false;
    }
  }
}
